        <mxCell id="c_ac" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;«dataclass»&lt;br&gt;AppContext&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ employee_manager: EmployeeManager&lt;br&gt;+ department_service: DepartmentService&lt;br&gt;+ storage: FileStorage" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;rounded=1;arcSize=4;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=10;spacingTop=6;spacingRight=10;spacingBottom=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
