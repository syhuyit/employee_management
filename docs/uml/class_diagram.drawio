        </mxCell>
        <mxCell id="c_em" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;EmployeeManager&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;# _department_service: DepartmentService&lt;br&gt;# _employees: dict[str, Employee]&lt;hr&gt;+ __init__(department_service: DepartmentService)&lt;br&gt;+ add_employee(employee: Employee): None&lt;br&gt;+ find_employee(employee_id: str): Employee&lt;br&gt;+ get_all(): list[Employee]&lt;br&gt;+ set_all(employees: list[Employee]): None&lt;br&gt;+ count(): int&lt;br&gt;+ update_employee(employee_id: str, **fields): Employee&lt;br&gt;+ delete_employee(employee_id: str): Employee&lt;br&gt;+ search_by_name(keyword: str): list[Employee]&lt;br&gt;+ search_by_department(department_id: str): list[Employee]&lt;br&gt;+ sort_employees(criteria: str, descending: bool = False): list[Employee]&lt;br&gt;+ total_salary_fund(): float" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;rounded=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;spacingTop=6;spacingRight=10;spacingBottom=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
