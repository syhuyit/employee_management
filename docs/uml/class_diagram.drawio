        </mxCell>
        <mxCell id="c_ds" value="&lt;div align=&quot;center&quot;&gt;&lt;b&gt;DepartmentService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;# _departments: dict[str, Department]&lt;hr&gt;+ __init__()&lt;br&gt;+ add_department(department: Department): None&lt;br&gt;+ get_department(department_id: str): Department&lt;br&gt;+ exists(department_id: str): bool&lt;br&gt;+ get_all(): list[Department]&lt;br&gt;+ set_all(departments: list[Department]): None&lt;br&gt;+ update_department(department_id: str, new_name: str): Department&lt;br&gt;+ delete_department(department_id: str, employees: list[Employee]): Department&lt;br&gt;+ transfer_employee(employee: Employee, new_department_id: str): None" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;rounded=1;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=10;spacingTop=6;spacingRight=10;spacingBottom=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1">
